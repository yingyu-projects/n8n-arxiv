      "parameters": {
        "jsCode": "function cleanJsonString(str) {\n  if (!str) return str;\n\n  let s = str.trim();\n\n  // Detect triple-backtick code block with or without \"json\"\n  const prefixPattern = /^```json\\s*/i;   // ```json\n  const genericPrefixPattern = /^```\\s*/; // ```\n  const suffixPattern = /\\s*```$/;        // ```\n\n  // Remove prefix if present\n  if (prefixPattern.test(s)) {\n    s = s.replace(prefixPattern, '');\n  } else if (genericPrefixPattern.test(s)) {\n    s = s.replace(genericPrefixPattern, '');\n  }\n\n  // Remove suffix if present\n  if (suffixPattern.test(s)) {\n    s = s.replace(suffixPattern, '');\n  }\n\n  return s.trim();\n}\n\n/**\n * Attempts to fix common JSON issues:\n * - Missing trailing }\n * - Trailing commas\n * - Unescaped quotes inside strings (basic handling)\n */\nfunction tryFixJson(str) {\n  let fixed = str.trim();\n\n  // Add missing closing braces\n  const openBraces = (fixed.match(/{/g) || []).length;\n  const closeBraces = (fixed.match(/}/g) || []).length;\n  if (openBraces > closeBraces) {\n    fixed += '}'.repeat(openBraces - closeBraces);\n  }\n\n  // Remove trailing commas before } or ]\n  fixed = fixed.replace(/,(\\s*[}\\]])/g, '$1');\n\n\n  return fixed;\n}\n\n\nconst raw = $input.first().json.output[0].content[0].text;\nconst cleaned = cleanJsonString(raw);\nconst fixedJson = tryFixJson(cleaned);\nlet parsed;\ntry {\n  parsed = JSON.parse(fixedJson);\n} catch (err) {\n  throw new Error(\n    'JSON parsing failed: ' +\n      err.message +\n      '\\nOriginal content was:\\n' + raw +\n      '\\nCleaned content was:\\n' + cleaned +\n      '\\nAttempted fixed content was:\\n' + fixedJson\n  );\n}\n\nreturn [{ json: parsed }];\n"
      },
