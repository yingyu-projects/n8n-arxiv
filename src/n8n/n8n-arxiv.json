      "parameters": {
        "jsCode": "// n8n Function Item Node: Clean Academic Paper Text\n// Input: $json.text (raw text from PDF)\n// Output: { cleaned_text: \"...\" }\n\nconst rawText = $input.first().json.text || '';\n\nif (!rawText || typeof rawText !== 'string') {\n  return { json: { cleaned_text: '', warning: 'Input text is empty or invalid' } };\n}\n\nlet text = rawText;\n\n// 5. Remove reference section and everything after\nconst refPatterns = [\n  /^references$/im,\n  /^bibliography$/im,\n  /^参考文献$/im,\n  /^acknowledgement/i,\n  /^acknowledgments/i,\n  /^致谢$/i,\n  /^appendix/i,\n  /^supplementary material/i,\n  /^ethics statement/i\n];\n\nfor (const pattern of refPatterns) {\n  const match = text.match(pattern);\n  if (match) {\n    const idx = match.index;\n    text = text.substring(0, idx).trim();\n    break;\n  }\n}\n\nreturn {\n  json: {\n    cleaned_text: text,\n    original_length: rawText.length,\n    cleaned_length: text.length,\n    reduction_ratio: ((1 - text.length / rawText.length) * 100).toFixed(1) + '%'\n  }\n};"
      },
