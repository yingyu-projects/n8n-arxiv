    {
      "parameters": {
        "jsCode": "// Input: items[0].json.arxiv is the array you provided\nconst arxivArray = $input.first().json.arxiv\n\nconst results = [];\n\nfor (let i = 0; i < arxivArray.length; i += 2) {\n    const metaBlock = arxivArray[i];       // Even index: contains pdf links\n    const titleBlock = arxivArray[i + 1];  // Odd index: contains title\n\n    if (!metaBlock || !titleBlock) continue;\n\n    // --- Extract PDF link ---\n    // The PDF link is like: <a href=\"/pdf/2511.21678\" ...>pdf</a>\n    const pdfMatch = metaBlock.match(/href=\"([^\"]*\\/pdf\\/[^\"]*)\"/);\n    const pdfLink = pdfMatch ? (\"https://arxiv.org\" + pdfMatch[1]) : null;\n\n    // --- Extract Title ---\n    // Title appears inside: <span class=\"descriptor\">Title:</span> ACTUAL TITLE\n    const titleMatch = titleBlock.match(/<span class=\"descriptor\">Title:<\\/span>\\s*(.*?)\\s*<\\/div>/);\n    const rawTitle = titleMatch ? titleMatch[1] : null;\n\n    // Clean HTML tags\n    const title = rawTitle ? rawTitle.replace(/<[^>]+>/g, \"\").trim() : null;\n\n    results.push({\n        title,\n        pdf: pdfLink,\n    });\n}\n\n\nreturn [\n    {\n        json: {\n            results\n        }\n    }\n];\n\n//return results.map(r => ({ json: r }));\n"
      },
